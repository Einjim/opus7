# Copy this file to .env and fill in real values for local development.
# On Vercel, set these under Project Settings -> Environment Variables
# instead (BLOB_READ_WRITE_TOKEN is added automatically once you create a
# Blob store for the project).

# Same Postgres database the original Flask app used -- nothing about the
# data changes, so you can point this at the exact same database.
DATABASE_URL= postgresql://neondb_owner:npg_Y3a0KMEPVmGj@ep-shy-river-auc2b8r9-pooler.c-10.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Same Gemini API key the original app used.
GEMINI_API_KEY=

# Reuse the exact same value from the Flask app's .env. It's hashed into a
# valid iron-session key internally (see lib/session.js), so whatever you
# had already works unchanged.
FLASK_SECRET_KEY=

# New: required for profile picture and teacherboard video uploads, since
# Vercel's servers don't have a persistent local disk to save files to
# (the original saved these to the static/ folder on disk). Create a Blob
# store under your Vercel project's Storage tab and copy the token it
# gives you -- Vercel adds this automatically for deployments once the
# store is connected, but you'll need to paste it here for local dev.
BLOB_READ_WRITE_TOKEN=
